{
  "name": "mobidex",
  "version": "1.3.10",
  "description": "Local bridge between Codex and the Mobidex mobile app. Run `mobidex up` to start.",
  "main": "src/index.js",
  "bin": {
    "mobidex": "./bin/mobidex.js",
    "remodex": "./bin/remodex.js"
  },
  "files": [
    "bin/",
    "src/"
  ],
  "scripts": {
    "start": "node ./bin/mobidex.js up",
    "test": "node --test ./test/*.test.js",
    "postinstall": "node ./src/bootstrap-codex-cli.js",
    "prepack": "node ./scripts/prepare-private-defaults.js",
    "postpack": "node ./scripts/cleanup-private-defaults.js"
  },
  "keywords": [
    "mobidex",
    "codex",
    "bridge",
    "cli"
  ],
  "author": "Ansar Ullah",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "qrcode-terminal": "^0.12.0",
    "ws": "^8.19.0"
  }
}
